{
  "name": "strata-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "generate:api": "openapi-typescript ../docs/spec/openapi.yaml -o src/api/generated/schema.ts && swagger2openapi ../docs/spec/admin.swagger.json -o src/api/generated/admin.openapi.json && openapi-typescript src/api/generated/admin.openapi.json -o src/api/generated/admin.ts && rm src/api/generated/admin.openapi.json",
    "test:lab": "playwright test -c playwright.lab.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.28.4",
    "clsx": "^2.1.0",
    "i18next": "^23.10.1",
    "lucide-react": "^0.359.0",
    "oidc-client-ts": "^3.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.1.0",
    "tailwind-merge": "^2.2.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.1",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.2",
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "jsdom": "^24.0.0",
    "openapi-typescript": "^6.7.5",
    "postcss": "^8.4.38",
    "swagger2openapi": "^7.0.8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vitest": "^1.4.0"
  }
}
