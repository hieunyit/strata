{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strata.example.test/rules/schema/plugin_exclusions.json",
  "title": "Strata Plugin Exclusions Schema",
  "description": "Ruleset exclusions for CMS and frameworks (WordPress, Drupal, Nextcloud, Magento, etc.) allowing false positive mitigation on known application routes and parameters.",
  "type": "object",
  "additionalProperties": false,
  "required": ["framework", "version", "exclusions"],
  "properties": {
    "framework": {
      "type": "string",
      "enum": ["wordpress", "drupal", "nextcloud", "magento", "cpanel", "generic"]
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "exclusions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "rule_ids"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "description": {
            "type": "string"
          },
          "path_prefix": {
            "type": "string"
          },
          "path_regex": {
            "type": "string"
          },
          "methods": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{3,16}$"
            }
          },
          "rule_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer"
            }
          },
          "target_vars": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
