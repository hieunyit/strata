{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strata.example.test/rules/schema/rule.schema.json",
  "title": "Strata rule file",
  "description": "One rule per file under rules/: the rule itself, in the IR the compiler reads (docs/spec/ir.schema.json), and requests it must and must not match. Checked by `strata-rules lint`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["rule", "tests"],
  "properties": {
    "rule": {
      "description": "Every rule carries source and license; imported ones also upstream_id, upstream_version and author (enforced by the IR schema).",
      "$ref": "https://strata.example.test/spec/ir.schema.json#/$defs/rule"
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["match", "no_match"],
      "properties": {
        "match": { "description": "Requests the rule must match.", "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/request" } },
        "no_match": { "description": "Requests the rule must not match.", "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/request" } }
      }
    }
  },
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "pattern": "^[A-Z]{1,16}$", "default": "GET" },
        "uri": { "description": "Raw request target, as sent on the request line.", "type": "string", "pattern": "^/", "maxLength": 8192 },
        "headers": {
          "description": "Header name -> value; a list repeats the header.",
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "type": "string" }, "minItems": 1 }
            ]
          }
        },
        "body": { "type": "string", "maxLength": 1048576 },
        "remote_addr": { "type": "string", "minLength": 2, "maxLength": 45 }
      }
    }
  }
}
