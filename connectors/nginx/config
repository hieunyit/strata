# ngx_http_strata_module: links libstrata (Rust, static) into the module.
# Build libstrata first: cargo build --release -p libstrata-ffi
# Override the archive location with STRATA_LIB=/path/to/libstrata.a

ngx_addon_name=ngx_http_strata_module

STRATA_ROOT=`cd "$ngx_addon_dir/../.." && pwd`
STRATA_LIB=${STRATA_LIB:-$STRATA_ROOT/target/release/libstrata.a}

if [ ! -f "$STRATA_LIB" ]; then
    echo "$0: error: libstrata not found at $STRATA_LIB"
    echo "$0: error: run \"cargo build --release -p libstrata-ffi\" first"
    exit 1
fi

STRATA_SRCS="                                                         \
    $ngx_addon_dir/src/ngx_http_strata_module.c                       \
    $ngx_addon_dir/src/ngx_http_strata_phase.c                        \
    $ngx_addon_dir/src/ngx_http_strata_filter.c                       \
    $ngx_addon_dir/src/ngx_http_strata_block.c                        \
    $ngx_addon_dir/src/ngx_http_strata_bundle.c                       \
    $ngx_addon_dir/src/ngx_http_strata_vars.c                         \
    $ngx_addon_dir/src/ngx_http_strata_response.c                     \
    "

STRATA_DEPS="                                                         \
    $ngx_addon_dir/include/strata.h                                   \
    $ngx_addon_dir/src/ngx_http_strata_module.h                       \
    "

# Two modules in one .so: the module itself, and its response filters,
# placed right before the copy filter, so that their body filter runs after
# the copy filter (file buffers in memory) and before gzip, sub_filter and
# SSI. ngx_module_order lists the filter only: the main module is appended.
ngx_module_type=HTTP_FILTER
ngx_module_name="ngx_http_strata_module ngx_http_strata_filter_module"
ngx_module_incs="$ngx_addon_dir/include $ngx_addon_dir/src"
ngx_module_deps="$STRATA_DEPS"
ngx_module_srcs="$STRATA_SRCS"
ngx_module_libs="$STRATA_LIB -lstdc++ -lpthread -ldl -lm"
ngx_module_order="ngx_http_strata_filter_module ngx_http_copy_filter_module"

. auto/module
