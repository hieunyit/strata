<!-- Strata Compact: one query may use at most 1 GiB and spills GROUP BY and
     ORDER BY to disk before that, so a heavy statistics query from the UI
     cannot starve event ingest (CP-A08/A09). -->
<clickhouse>
    <profiles>
        <default>
            <max_memory_usage>1073741824</max_memory_usage>
            <max_bytes_before_external_group_by>536870912</max_bytes_before_external_group_by>
            <max_bytes_before_external_sort>536870912</max_bytes_before_external_sort>
            <max_threads>4</max_threads>
        </default>
    </profiles>
</clickhouse>
