# systemd EnvironmentFile: one value per argument, no aggregate shell flags.
# BUNDLE_SOURCE is exactly one --bundle-file=... or --bundle-url=... argument.
# Set exactly one source; signed bundles require the trusted /etc/strata/bundle.pub.
STRATA_BUNDLE_SOURCE=--bundle-file=/var/lib/strata/standalone/source.sbn
STRATA_EVENTS_JSONL=/var/log/strata/events.jsonl
STRATA_SYSLOG_ADDR=
STRATA_METRICS_ADDR=127.0.0.1:9469
STRATA_NODE_ID=standalone
# Optional policy pin, checked on each update and when restoring active content.
STRATA_REQUIRED_POLICY=
STRATA_REQUIRE_FULL_ENFORCE=false
