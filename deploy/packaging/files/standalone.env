# strata-agent standalone settings (systemd EnvironmentFile).
# Prometheus endpoint of the agent: bind it where only the scraper reaches
STRATA_METRICS_ADDR=127.0.0.1:9469

# Standalone arguments: bundle source, SIEM events, syslog, pubkey
# Examples:
# STRATA_STANDALONE_ARGS="--bundle-dir=/var/lib/strata/bundles --events-jsonl=/var/log/strata/events.jsonl"
# STRATA_STANDALONE_ARGS="--bundle-file=/var/lib/strata/bundles/bundle.sbn --events-jsonl=/var/log/strata/events.jsonl --syslog-addr=127.0.0.1:514"
STRATA_STANDALONE_ARGS="--bundle-dir=/var/lib/strata/bundles --events-jsonl=/var/log/strata/events.jsonl"
