# strata-agent settings (systemd EnvironmentFile). install.sh fills them in.
# Control plane FleetService (mTLS), host:port
STRATA_SERVER=
# TLS name of the control plane when it differs from the host of STRATA_SERVER
STRATA_SERVER_NAME=
# Prometheus endpoint of the agent: bind it where only the scraper reaches
STRATA_METRICS_ADDR=127.0.0.1:9469
