[Unit]
Description=Strata agent (bundles, events, metrics for the proxy module)
Documentation=https://github.com/hieunyit/strata/blob/main/docs/runbook/README.md
After=network-online.target strata-agent.socket
Wants=network-online.target
# the event socket (W13-G1-01); the agent takes it from systemd
Requires=strata-agent.socket
# enrolled first: strata-agent enroll (deploy/packaging/install.sh does it)
ConditionPathExists=/var/lib/strata/identity/node-id

[Service]
User=strata
Group=strata
EnvironmentFile=/etc/strata/agent.env
ExecStart=/usr/bin/strata-agent run \
    --server=${STRATA_SERVER} --server-name=${STRATA_SERVER_NAME} \
    --identity-dir=/var/lib/strata/identity --spool-dir=/var/lib/strata/spool \
    --bundle-dir=/var/lib/strata/bundles --control-file=/var/lib/strata/bundles/control \
    --event-socket=unix:/run/strata/events.sock --metrics-file=/run/strata/metrics \
    --metrics-addr=${STRATA_METRICS_ADDR}
Restart=always
RestartSec=2
LimitNOFILE=65536
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/strata /run/strata

[Install]
WantedBy=multi-user.target
